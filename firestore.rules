rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function safeUserFields() {
      return request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'createdAt', 'updatedAt', 'role']);
    }
    function publishedContent() { return resource.data.status == 'published'; }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'learner'
        && safeUserFields();
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && safeUserFields();
      allow delete: if false;

match /savedExperiments/{experimentId} {
      // 1. Chỉ chủ nhân của bài thí nghiệm mới được đọc, sửa, xóa
      allow read, update, delete: if signedIn() && request.auth.uid == resource.data.uid;
      
      // 2. Khi tạo mới, bắt buộc phải gắn đúng thẻ tên (uid) của người tạo
      allow create: if signedIn() 
                    && request.auth.uid == request.resource.data.uid
                    && request.resource.data.keys().hasOnly(['uid', 'input', 'modelVersion', 'createdAt']);
    }

    match /{contentCollection}/{contentId} {
      allow read: if publishedContent() || isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
