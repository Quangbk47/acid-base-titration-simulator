rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function safeUserFields() {
      return request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'createdAt', 'updatedAt', 'role']);
    }
    function publishedContent() { return resource.data.status == 'published'; }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'learner'
        && safeUserFields();
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && safeUserFields();
      allow delete: if false;

      match /savedExperiments/{experimentId} {
        allow read, update, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['input', 'modelVersion', 'currentAddedVolumeMl', 'currentStage', 'summary', 'createdAt', 'updatedAt']);
      }
    }

    match /{contentCollection}/{contentId} {
      allow read: if publishedContent() || isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
